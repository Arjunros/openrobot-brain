<!--
  OpenRobot-Brain tabletop scene: Franka Emika Panda (MuJoCo Menagerie, Apache-2.0)
  in front of a work mat with three coloured cubes. Simulation only.
  World frame: robot base at the origin, +x away from the robot, +y to the robot's left,
  work surface at z = 0. Units: metres, radians.
-->
<mujoco model="orb_tabletop">
  <include file="panda.xml"/>

  <option timestep="0.002" cone="elliptic" impratio="10"/>

  <visual>
    <headlight diffuse="0.35 0.35 0.35" ambient="0.25 0.25 0.25" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-25" offwidth="1280" offheight="960"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.45 0.6" rgb2="0.05 0.05 0.08" width="512" height="3072"/>
    <texture type="2d" name="floor" builtin="checker" mark="edge" rgb1="0.22 0.24 0.27" rgb2="0.18 0.2 0.23"
      markrgb="0.35 0.37 0.4" width="300" height="300"/>
    <material name="floor" texture="floor" texuniform="true" texrepeat="6 6" reflectance="0.05"/>
    <material name="mat" rgba="0.55 0.53 0.48 1" specular="0" shininess="0"/>
    <material name="cube_red" rgba="0.86 0.16 0.14 1"/>
    <material name="cube_green" rgba="0.16 0.66 0.25 1"/>
    <material name="cube_blue" rgba="0.15 0.35 0.85 1"/>
    <material name="obstacle" rgba="0.36 0.38 0.42 1" specular="0.1"/>
    <!-- zone tints are muted on purpose: clearly coloured, but never as saturated as a cube -->
    <material name="zone_red" rgba="0.78 0.42 0.42 1" specular="0"/>
    <material name="zone_green" rgba="0.42 0.66 0.42 1" specular="0"/>
    <material name="zone_blue" rgba="0.42 0.52 0.80 1" specular="0"/>
  </asset>

  <default>
    <default class="cube">
      <geom type="box" size="0.02 0.02 0.02" mass="0.05" friction="1.5 0.02 0.002"
        condim="4" solref="0.005 1" solimp="0.95 0.99 0.001"/>
    </default>
  </default>

  <worldbody>
    <light pos="0.6 -0.4 1.8" dir="-0.15 0.2 -1" directional="true" castshadow="true" diffuse="0.45 0.45 0.45" specular="0.1 0.1 0.1"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="floor"/>
    <!-- Thin visual work mat; physics contact is with the floor plane. -->
    <geom name="mat" type="box" pos="0.52 0 0.0003" size="0.26 0.34 0.0003" material="mat" contype="0" conaffinity="0"/>

    <!-- Overhead camera used for AI vision: looks straight down, image "up" = +x (away from robot). -->
    <camera name="overhead" pos="0.55 0 1.2" xyaxes="0 -1 0 1 0 0" fovy="38"/>
    <!-- Angled camera for videos. -->
    <camera name="front" pos="1.55 -1.15 1.05" xyaxes="0.6771 0.7359 -0.0000 -0.2906 0.2673 0.9187" fovy="45"/>

    <body name="red_cube" pos="0.45 0.15 0.02">
      <freejoint name="red_cube"/>
      <geom class="cube" material="cube_red"/>
    </body>
    <body name="green_cube" pos="0.6 0.0 0.02">
      <freejoint name="green_cube"/>
      <geom class="cube" material="cube_green"/>
    </body>
    <body name="blue_cube" pos="0.45 -0.15 0.02">
      <freejoint name="blue_cube"/>
      <geom class="cube" material="cube_blue"/>
    </body>

    <!-- Fixed obstacles, 16 cm tall: tall enough to block the robot's 16 cm carrying height (so it must
         go around or over), low enough to clear the Panda's forearm when gripping a cube right beside them.
         Mocap bodies: code places them per scene; physics never moves them.
         Unused ones are parked far off the table. Sizes must match OBSTACLE_SPECS in scenes.py
         (a test checks this). -->
    <body name="obstacle_wall" mocap="true" pos="5 5 0.08">
      <geom name="wall" type="box" size="0.10 0.02 0.08" material="obstacle"/>
    </body>
    <body name="obstacle_post_a" mocap="true" pos="5 6 0.08">
      <geom name="post_a" type="cylinder" size="0.025 0.08" material="obstacle"/>
    </body>
    <!-- Zones: flat marked squares on the mat (15 cm). Visual only: nothing collides with them. -->
    <body name="zone_red" mocap="true" pos="6 5 0.0008">
      <geom type="box" size="0.075 0.075 0.0002" material="zone_red" contype="0" conaffinity="0"/>
    </body>
    <body name="zone_green" mocap="true" pos="6 6 0.0008">
      <geom type="box" size="0.075 0.075 0.0002" material="zone_green" contype="0" conaffinity="0"/>
    </body>
    <body name="zone_blue" mocap="true" pos="6 7 0.0008">
      <geom type="box" size="0.075 0.075 0.0002" material="zone_blue" contype="0" conaffinity="0"/>
    </body>
    <body name="obstacle_post_b" mocap="true" pos="5 7 0.08">
      <geom name="post_b" type="cylinder" size="0.025 0.08" material="obstacle"/>
    </body>
  </worldbody>
</mujoco>
