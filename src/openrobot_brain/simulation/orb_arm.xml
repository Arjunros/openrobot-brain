<!--
  OpenRobot-Brain 4-DOF demo arm (simulation only).
  Hard joint ranges here are WIDER than the software limits in config.py;
  tests enforce that relationship. Angles in radians.
-->
<mujoco model="orb_arm_4dof">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <default>
    <joint damping="2.0" armature="0.05" limited="true"/>
    <geom contype="0" conaffinity="0" rgba="0.75 0.78 0.82 1"/>
    <position kp="80" kv="6" forcerange="-40 40"/>
  </default>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.18 0.2 0.23" rgb2="0.24 0.26 0.3" width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="6 6" reflectance="0.1"/>
    <material name="accent" rgba="0.95 0.55 0.15 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 2.5" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="1.5 1.5 0.05" material="grid"/>
    <geom name="pedestal" type="cylinder" size="0.08 0.05" pos="0 0 0.05" rgba="0.3 0.32 0.36 1"/>

    <body name="base" pos="0 0 0.1" gravcomp="1">
      <joint name="shoulder_yaw" type="hinge" axis="0 0 1" range="-1.57 1.57"/>
      <geom type="cylinder" size="0.06 0.04" pos="0 0 0.04" mass="1.0"/>

      <body name="upper_arm" pos="0 0 0.08" gravcomp="1">
        <joint name="shoulder_pitch" type="hinge" axis="0 1 0" range="-1.2 1.5"/>
        <geom type="capsule" fromto="0 0 0 0 0 0.3" size="0.035" mass="0.8"/>

        <body name="forearm" pos="0 0 0.3" gravcomp="1">
          <joint name="elbow_pitch" type="hinge" axis="0 1 0" range="-2.0 2.0"/>
          <geom type="capsule" fromto="0 0 0 0 0 0.25" size="0.03" mass="0.5"/>

          <body name="wrist" pos="0 0 0.25" gravcomp="1">
            <joint name="wrist_pitch" type="hinge" axis="0 1 0" range="-1.5 1.5"/>
            <geom type="box" size="0.03 0.03 0.04" pos="0 0 0.04" material="accent" mass="0.2"/>
            <site name="tool" pos="0 0 0.09" size="0.012" rgba="1 0.2 0.2 1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="act_shoulder_yaw" joint="shoulder_yaw" ctrlrange="-1.57 1.57"/>
    <position name="act_shoulder_pitch" joint="shoulder_pitch" ctrlrange="-1.2 1.5"/>
    <position name="act_elbow_pitch" joint="elbow_pitch" ctrlrange="-2.0 2.0"/>
    <position name="act_wrist_pitch" joint="wrist_pitch" ctrlrange="-1.5 1.5"/>
  </actuator>
</mujoco>
