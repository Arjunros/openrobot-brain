# Copy to .env and fill in. .env is git-ignored; never commit a real key.
# Get a key at https://aistudio.google.com/apikey
# Gemini 4 Argon requires a project on the PAID tier of the Gemini API.
GEMINI_API_KEY=

# Optional. Defaults to gemini-4-argon. The code never swaps models on its own.
# GEMINI_MODEL=gemini-4-argon
