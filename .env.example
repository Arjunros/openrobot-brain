# Copy to .env and fill in. .env is git-ignored; never commit or screenshot a real key.

# OpenAI key: https://platform.openai.com/api-keys
# API usage is billed separately from ChatGPT Plus/Pro; add credit under Settings -> Billing.
OPENAI_API_KEY=

# Optional. Defaults to gpt-6-astra. The code never swaps models on its own.
# OPENAI_MODEL=gpt-6-astra
