# Copy to .env and fill in. .env is git-ignored; never commit a real key.
# You only need ONE of the two providers.

# --- Google Gemini 4 Argon -------------------------------------------------
# Key: https://aistudio.google.com/apikey  (project must be on the PAID tier)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-4-argon

# --- OpenAI GPT-6 Astra ----------------------------------------------------
# Key: https://platform.openai.com/api-keys
# API usage is billed separately from ChatGPT Plus/Pro; add credit under Settings -> Billing.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-astra

# Which planner `orb plan` uses when --provider isn't given: gemini | openai
# If unset: Gemini when GEMINI_API_KEY is set, otherwise OpenAI.
# ORB_PROVIDER=openai
